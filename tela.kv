                        height: "80dp"
                        font_size: '18sp'
                    TextInput:
                        id: valor_cobrado
                        hint_text: 'INSIRA O VALOR'
                        multiline: False
                        readonly: True
                        size_hint_y: None
                        height: "48dp"
                        font_size: '18sp'
                        on_touch_down:
                            if self.collide_point(*args[1].pos): root.manager.current = 'valor_servico'
                    MDLabel:
                        text: "JÁ FOI PAGO?"
                    MDSwitch:
                        id: pago_switch
                        active: False
                        width: "60dp"
                    MDRaisedButton:
                        text: "CONFIRMAR"
                        size_hint_y: None
                        height: "48dp"
                        on_release: root.salvar_alteracoes()

<TelaServicosFinalizados>:
    name: "tela_servicos_finalizados"
    MDBoxLayout:
        orientation: "vertical"
        MDTopAppBar:
            title: "SERVIÇOS FINALIZADOS"
            left_action_items: [["arrow-left", lambda x: setattr(app.root, "current", "tela_inicio")]]
        ScrollView:
            MDList:
                id: lista_servicos_finalizados

<TelaServicosNaoPagos>:
    name: "tela_servicos_nao_pagos"
    MDBoxLayout:
        orientation: "vertical"
        MDTopAppBar:
            title: "PAGAMENTOS PENDENTES"
            left_action_items: [["arrow-left", lambda x: setattr(app.root, "current", "tela_inicio")]]
        ScrollView:
            MDList:
                id: lista_servicos_nao_pagos

<TelaGerenciadorDeFinancas>:
    name: "tela_gerenciamento_financas"
    MDScreen:
        MDBoxLayout:
            id: widgets_controle_financas
            orientation: "vertical"
            MDTopAppBar:
                title: "CONTROLE DE FATURAMENTO"
                left_action_items: [["arrow-left", lambda x: setattr(app.root, "current", "tela_inicio")]]
                size_hint_y: None
                height: "56dp"
            FloatLayout:
                TextInput:
                    id: data_inicio
                    hint_text: 'DATA INÍCIO (DD/MM/AAAA)'
                    multiline: False
                    readonly: True
                    size_hint: 0.8, None
                    height: "48dp"
                    font_size: '18sp'
                    pos_hint: {'center_x': 0.5, 'y': 0.80}
                    on_touch_down:
                        if self.collide_point(*args[1].pos): root.mandar_id_widget1()
                TextInput:
                    id: data_fim
                    hint_text: 'DATA FIM (DD/MM/AAAA)'
                    multiline: False
                    readonly: True
                    size_hint: 0.8, None
                    height: "48dp"
                    font_size: '18sp'
                    pos_hint: {'center_x': 0.5, 'y': 0.65}
                    on_touch_down:
                        if self.collide_point(*args[1].pos): root.mandar_id_widget2()
                MDFillRoundFlatButton:
                    text: 'CONFIRMAR'
                    size_hint: 0.8, 0.08
                    font_size: '18sp'
                    background_normal: ''
                    background_color: app.theme_cls.primary_color
                    pos_hint: {'center_x': 0.5, 'y': 0.50}
                    on_release: root.carregar_faturamento()
                MDRaisedButton:
                    id: botao_faturamento
                    text: ''
                    size_hint: 0.9, None
                    opacity: 0
                    height: "60dp"
                    pos_hint: {'center_x': 0.5, 'y': 0.30}

<TelaGerarCobranca>:
    name: "gerar_cobranca"
    MDScreen:
        MDBoxLayout:
            orientation: "vertical"
            MDTopAppBar:
                title: "GERAR COBRANÇA"
                left_action_items: [["arrow-left", lambda x: setattr(app.root, "current", "tela_inicio")]]
            Widget:
                size_hint_y: None
                height: "40dp"
            MDBoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: "100dp"
                padding: "10dp"
                spacing: "10dp"
                MDTextField:
                    id: nome_cliente
                    hint_text: "Digite o nome do cliente"
                MDRaisedButton:
                    text: "BUSCAR"
                    pos_hint: {"center_x": 0.5}
                    on_release: root.buscar_cliente()
            ScrollView:
                MDList:
                    id: lista_clientes

<TelaBackUp>:
    name: "tela_backup"
    canvas.before:
        Color:
            rgba: 1, 1, 1, 1
        Rectangle:
            pos: self.pos
            size: self.size
    MDBoxLayout:
        orientation: "vertical"
        MDTopAppBar:
            title: "ÁREA DE BACKUP"
            elevation: 4
            left_action_items:
                [["arrow-left", lambda x: setattr(app.root, "current", "tela_inicio")]]
        ScrollView:
            MDBoxLayout:
                orientation: "vertical"
                padding: "20dp"
                spacing: "15dp"
                size_hint_y: None
                height: self.minimum_height
                MDCard:
                    orientation: "vertical"
                    padding: "15dp"
                    spacing: "8dp"
                    size_hint_y: None
                    height: "110dp"
                    radius: [18, 18, 18, 18]
                    elevation: 3
                    MDIcon:
                        icon: "database"
                        halign: "center"
                        theme_text_color: "Primary"
                        font_size: "32sp"
                    MDLabel:
                        id: label_status_backup
                        text: "Nenhum backup local encontrado."
                        markup: True
                        halign: "center"
                        adaptive_height: True
                MDCard:
                    orientation: "vertical"
                    padding: "15dp"
                    spacing: "12dp"
                    size_hint_y: None
                    height: "145dp"
                    radius: [18, 18, 18, 18]
                    elevation: 3

                    MDBoxLayout:
                        orientation: "horizontal"
                        spacing: "12dp"
                        adaptive_height: True

                        MDIcon:
                            icon: "google-drive"
                            font_size: "34sp"
                            size_hint_x: None
                            width: "45dp"
                            halign: "center"
                            theme_text_color: "Primary"

                        MDBoxLayout:
                            orientation: "vertical"
                            adaptive_height: True

                            MDLabel:
                                text: "CONTA DO GOOGLE DRIVE"
                                bold: True
                                adaptive_height: True

                            MDLabel:
                                text: root.google_email if root.google_conectado else "Nenhuma conta conectada"
                                theme_text_color: "Custom"
                                text_color: (0.1, 0.55, 0.2, 1) if root.google_conectado else (0.45, 0.45, 0.45, 1)
                                adaptive_height: True
                                shorten: True
                                shorten_from: "right"

                        MDIconButton:
                            icon: "logout"
                            disabled: not root.google_conectado
                            opacity: 1 if root.google_conectado else 0
                            theme_text_color: "Custom"
                            text_color: (0.9, 0.1, 0.1, 1)
                            on_release: root.confirmar_desconexao_google()

                    MDFillRoundFlatIconButton:
                        id: botao_google_drive
                        text: "GOOGLE DRIVE CONECTADO" if root.google_conectado else "CONECTAR AO GOOGLE DRIVE"
                        icon: "check-circle" if root.google_conectado else "google-drive"
                        disabled: root.google_conectado
                        size_hint_x: 0.95
                        size_hint_y: None
                        height: "48dp"
                        pos_hint: {"center_x": 0.5}
                        on_release: root.conectar_google_drive()
                MDFillRoundFlatIconButton:
                    text: "REALIZAR BACKUP"
                    icon: "database-plus"
                    size_hint_x: 0.9
                    size_hint_y: None
                    height: "52dp"
                    pos_hint: {"center_x": 0.5}
                    on_release: root.fazer_backup()
                MDLabel:
                    text: "BACKUPS DISPONÍVEIS"
                    bold: True
                    halign: "center"
                    adaptive_height: True
                MDCard:
                    orientation: "vertical"
                    size_hint_y: None
                    height: "350dp"
                    radius: [15, 15, 15, 15]
                    elevation: 2
                    ScrollView:
                        MDList:
                            id: lista_backups