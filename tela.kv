                        size_hint_y: None
                        height: "48dp"
                    TextInput:
                        id: descricao
                        hint_text: 'DESCRIÇÃO'
                        size_hint_y: None
                        height: "80dp"
                        font_size: '18sp'
                    TextInput:
                        id: data_servico
                        hint_text: 'DATA (DD/MM/AAAA)'
                        multiline: False
                        readonly: True
                        size_hint_y: None
                        height: "48dp"
                        font_size: '18sp'
                        on_touch_down:
                            if self.collide_point(*args[1].pos): root.manager.current = 'tela_calendario'
                    TextInput:
                        id: nome_cliente
                        hint_text: 'NOME DO CLIENTE'
                        multiline: False
                        size_hint_y: None
                        height: "48dp"
                        font_size: '18sp'
                    TextInput:
                        id: numero_contato
                        hint_text: 'NÚMERO PARA CONTATO'
                        multiline: False
                        size_hint_y: None
                        height: "48dp"
